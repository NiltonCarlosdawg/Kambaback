generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  nome              String    @db.VarChar(100)
  email             String    @unique @db.VarChar(255)
  telefone          String?   @unique @db.VarChar(20)
  senha             String?   @db.VarChar(255)
  dataNascimento    DateTime
  sexo              Sexo
  morada            String    @db.VarChar(255)
  rendaMensalMedia  Decimal   @default(0) @db.Decimal(12, 2)
  perfilDeRisco     PerfilRisco @default(MOD_ERADO)
  tipoRenda          String?  @default("FIXO") // FIXO | VARIAVEL | MISTO | INFORMAL
  rendaFixaMensal    Decimal? @db.Decimal(15, 2)
  rendaVariavelMedia Decimal? @db.Decimal(15, 2)
  rendaEmDolar       Boolean  @default(false)
  percentualDolar    Int?     @default(0)
  fontesRenda        String[] @default([])
  
  role              Role      @default(USER)
  ativo             Boolean   @default(true)
  bloqueado         Boolean   @default(false)
  verificado        Boolean   @default(false)
  tutorialConcluido Boolean   @default(false)
  
  googleId          String?   @unique
  appleId           String?   @unique
  refreshToken      String?
  senhaAlteradaEm   DateTime?
  ultimoLogin       DateTime?
  
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  // Relações
  cartoes           Cartao[]
  gastos            Gasto[]
  objetivos         Objetivo[]
  categorias        Categoria[]
  kambaMemoria      KambaMemoria[]
  kambaEmbeddings   KambaEmbedding[]
  kambaThread       KambaThread[]
  kambaPreferencias KambaPreferencias?
  kambaUsage        KambaUsage[]
  kambaLembretes    KambaLembrete[]
  kambaFeedback     KambaFeedback[]
  dispositivos      DispositivoPush[]
  notificacoes      NotificacaoPush[]
  preferencias      PreferenciasUsuario?
   notificacoesSistema Notificacao[]
   kixikilasOrganizadas  Kixikila[]       @relation("KixikilaOrganizador")
   kixikilasMembro       KixikilaMembro[] @relation("KixikilaMembros")

  passwordResetTokens PasswordResetToken[]
  // F-032: @@index([email]) e @@index([telefone]) eram redundantes (ambos já
  // @unique — a PK do unique já serve de índice)
}

model Cartao {
  id                      String   @id @default(cuid())
  nome                    String   @db.VarChar(100)
  tipo                    TipoCartao
  banco                   String   @db.VarChar(100)
  // F-033: `numero` é cifrado com AES-256-GCM (formato iv:authTag:encrypted) —
  // deixa de caber em VarChar(50), usamos text
  numero                  String?
  saldoAtual              Decimal  @default(0) @db.Decimal(12, 2)
  limiteCredito           Decimal? @default(0) @db.Decimal(12, 2)
  moeda                   String   @default("AOA") // AOA | USD | EUR
  diaFechamento           Int?
  diaVencimento           Int?
  cor                     String   @default("#6366f1") @db.VarChar(7)
  icone                   String   @default("credit-card") @db.VarChar(50)
  isFundoEmergencia  Boolean  @default(false)
fundoAtivo         Boolean  @default(false)
  // Campos para controle de saldo disponível e reservado
  saldoDisponivel         Decimal  @default(0) @db.Decimal(12, 2)
  saldoReservado          Decimal  @default(0) @db.Decimal(12, 2)
  
  // Define se o cartão distribui receitas automaticamente
  distribuirParaObjetivos Boolean  @default(false)
  percentualDistribuicaoPoupanca Decimal @default(0) @db.Decimal(5, 2)
  
  ativo                   Boolean  @default(true)
  excluido                Boolean  @default(false)
  usuarioId               String
  usuario                 User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  gastos                  Gasto[]
  criadoEm                DateTime @default(now())
  atualizadoEm            DateTime @updatedAt

  // F-032: unicidade composta (o catch P2002 nos controllers deixa de ser morto)
  // + índice composto para os filtros quentes (ativo & excluido)
  @@unique([usuarioId, numero])
  @@index([usuarioId, ativo, excluido])
}

model Objetivo {
  id                      String   @id @default(cuid())
  titulo                  String   @db.VarChar(200)
  descricao               String?  @db.Text
  valorAlvo               Decimal  @db.Decimal(12, 2)
  valorAtual              Decimal  @default(0) @db.Decimal(12, 2)
  dataPrevista            DateTime
  categoria               String   @default("Geral") @db.VarChar(50)
  prioridade              Prioridade @default(MEDIA) 
  icone                   String   @default("target") @db.VarChar(50)
  cor                     String   @default("#10b981") @db.VarChar(7)
  
  // Percentagem de distribuição automática (0-100)
  porcentagemDistribuicao Decimal  @default(0) @db.Decimal(5, 2)
  
  concluido               Boolean  @default(false)
  excluido                Boolean  @default(false)
  usuarioId               String
  usuario                 User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  // Relação inversa para depósitos manuais
  gastos                  Gasto[]
  
  criadoEm                DateTime @default(now())
  atualizadoEm            DateTime @updatedAt

  @@index([usuarioId])
}
model Gasto {
  id            String    @id @default(cuid())
  tipo          TipoGasto
  valor         Decimal   @db.Decimal(12, 2)
  descricao     String    @db.VarChar(500)
  moeda         String    @default("AOA") // AOA | USD | EUR
  valorOriginal Decimal?  @db.Decimal(15, 2)
  taxaCambio    Decimal?  @db.Decimal(10, 4)
  data          DateTime  @default(now())
  local         String?   @db.VarChar(200)
  parcelado     Boolean   @default(false)
  totalParcelas Int       @default(1)
  parcelaAtual  Int       @default(1)
  tags          String[]  @default([])
  excluido      Boolean   @default(false)
  
  // NOVO: Flag para rastrear se houve distribuição automática (para estorno preciso)
  distribuicaoAutomatica Boolean @default(false)
  percentualDistribuicaoPoupanca Decimal @default(0) @db.Decimal(5, 2)
  valorDistribuidoPoupanca Decimal @default(0) @db.Decimal(12, 2)
  // F-014: repartição efectiva persistida no momento da criação
  // [{ objetivoId, valor }] — o estorno reverte EXACTAMENTE estes valores
  // (não recomputa com os pesos actuais, que podem ter mudado)
  distribuicoesDetalhes Json?
  
  usuarioId     String
  usuario       User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cartaoId      String
  cartao        Cartao    @relation(fields: [cartaoId], references: [id], onDelete: Cascade)
  categoriaId   String
  categoria     Categoria @relation(fields: [categoriaId], references: [id])

  // Campo opcional para vincular um gasto (depósito) a um objetivo
  objetivoId    String?
  objetivo      Objetivo? @relation(fields: [objetivoId], references: [id], onDelete: SetNull)

  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  @@index([usuarioId, excluido, data])
  @@index([usuarioId, tipo, excluido, data])
  @@index([cartaoId])
  @@index([categoriaId])
  @@index([objetivoId])
}

model Categoria {
  id           String        @id @default(cuid())
  nome         String        @db.VarChar(100)
  tipo         TipoCategoria
  cor          String        @default("#94a3b8") @db.VarChar(7)
  icone        String?       @db.VarChar(50)
  padrao       Boolean       @default(false)
  ordem        Int           @default(0)
  excluido     Boolean       @default(false)
  ativa        Boolean       @default(true)
  
  usuarioId    String?  
  usuario      User?         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  gastos       Gasto[]

  // F-032: unicidade de nome por utilizador + índice composto
  @@unique([usuarioId, nome])
  @@index([tipo])
}

// Modelos de memória semântica para busca inteligente de contexto
model KambaEmbedding {
  id          String   @id @default(cuid())
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  content     String   @db.Text                        // Texto original
  contexto    String   @db.VarChar(50)                  // 'user', 'assistant', 'sumario'
  threadId    String   @default("default")
  embedding   Json?                                     // Array de 384 floats (vector)
  criadoEm    DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@index([usuarioId, threadId])
}

model KambaMemoria {
  id          String   @id @default(cuid())
  role        String   @db.VarChar(20)    // "user" ou "assistant"
  content     String   @db.Text
  contexto    String   @db.Text            // Contexto da conversa (resumo/json)
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  threadId    String   @default("default") // ID da thread de conversação
  criadoEm    DateTime @default(now())
  
  @@index([usuarioId, criadoEm])
  @@index([usuarioId, threadId])
}

model KambaThread {
  id          String   @id @default(cuid())
  nome        String   @db.VarChar(200)   // Nome da thread
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ativa       Boolean  @default(true)     // Se a thread está ativa
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  
  @@index([usuarioId, ativa])
}

model KambaPreferencias {
  id               String   @id @default(cuid())
  usuarioId        String   @unique
  usuario          User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  // Preferências detectadas
  temNegocio       Boolean  @default(false)
  preocupaComDolar Boolean  @default(false)
  querPoupar       Boolean  @default(false)
  temDividas       Boolean  @default(false)
  estiloResposta   String   @default("normal") @db.VarChar(20) // curto, normal, detalhado
  temasFrequentes  String[] @default([]) // Array de temas mais discutidos
  
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt
}

model KambaUsage {
  id            String    @id @default(cuid())
  tokens        Int
  latencia      Int?                      // Tempo de resposta em ms
  modelo        String?   @db.VarChar(100)  // Modelo de IA usado
  sucesso       Boolean   @default(true)
  erro          String?   @db.Text          // Mensagem de erro se falhou
  intencao      String?   @db.VarChar(50)   // Intenção detectada
  sentimento    String?   @db.VarChar(20)   // Sentimento detectado
  confianca     Float?                      // Confiança da classificação
  ferramentas   Json?                       // Tools usadas: [{ nome, sucesso }]
  promptVersao  String?   @db.VarChar(20)   // Versão do prompt (A/B test)
  feedbackId    String?                     // Ligação ao feedback opcional
  usuarioId     String
  usuario       User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm      DateTime  @default(now())
  
  @@index([usuarioId, criadoEm])
  @@index([intencao])
  @@index([promptVersao])
}

// Modelo para A/B testing de prompts
model KambaPromptTest {
  id            String   @id @default(cuid())
  versao        String   @db.VarChar(20)    // 'A', 'B', 'control'
  nome          String   @db.VarChar(100)   // Nome descritivo do teste
  descricao     String?  @db.Text           // O que está a ser testado
  promptContent String   @db.Text           // Conteúdo do system prompt
  ativo         Boolean  @default(true)     // Se esta versão está activa
  usuariosAlocados Int   @default(0)        // Qtd de users nesta versão
  scoreMedio    Float    @default(0)        // Avaliação média recebida
  totalRespostas Int     @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([ativo, versao])
}

model KambaLembrete {
  id          String   @id @default(cuid())
  tipo        String   @db.VarChar(50)    // Tipo do lembrete (gasto_alto, objetivo_perto, etc)
  titulo      String   @db.VarChar(200)
  mensagem    String   @db.Text
  dataHora    DateTime                    // Quando deve ser enviado
  enviado     Boolean   @default(false)   // Se já foi enviado
  lido        Boolean   @default(false)   // Se o usuário já leu
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  @@index([usuarioId, enviado, dataHora])
}

model KambaFeedback {
  id          String   @id @default(cuid())
  avaliacao   Int
  comentario  String?  @db.Text
  mensagemId  String?                     // Ligação ao registo de KambaUsage
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now())

  @@index([usuarioId, criadoEm])
}

model DispositivoPush {
  id           String    @id @default(cuid())
  usuarioId    String
  token        String    @unique @db.Text
  tipo         String    @db.VarChar(50)
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  usuario      User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model NotificacaoPush {
  id           String    @id @default(cuid())
  usuarioId    String
  titulo       String    @db.VarChar(200)
  corpo        String    @db.Text
  lida         Boolean   @default(false)
  tipo         String    @db.VarChar(50)
  criadoEm     DateTime  @default(now())
  usuario      User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Modelo para notificações internas do sistema (WebSocket)
model Notificacao {
  id          String   @id @default(cuid())
  usuarioId   String
  tipo        String   @db.VarChar(50)
  titulo      String   @db.VarChar(200)
  mensagem    String   @db.Text
  dados       Json?    
  lido        Boolean  @default(false)
  enviadoEm   DateTime @default(now())
  lidoEm      DateTime?
  
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  @@index([usuarioId, lido])
  @@index([enviadoEm])
  @@map("notificacoes")
}

model PreferenciasUsuario {
  id                  String    @id @default(cuid())
  usuarioId           String    @unique
  idioma              String    @default("pt") @db.VarChar(10)
  tema                String    @default("light") @db.VarChar(20)
  notificacoesAtivas  Boolean   @default(true)
  moedaPadrao         String    @default("Kz") @db.VarChar(10)
  usuario             User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Kixikila {
  id                String            @id @default(cuid())
  organizadorId     String
  organizador       User              @relation("KixikilaOrganizador", fields: [organizadorId], references: [id])
  nome              String
  contribuicaoMensal Decimal          @db.Decimal(15, 2)
  totalMembros      Int
  periodicidade     String            @default("MENSAL") // MENSAL | QUINZENAL | SEMANAL
  cicloActual       Int               @default(1)
  ativa             Boolean           @default(true)
  membros           KixikilaMembro[]
  contribuicoes     KixikilaContribuicao[]
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt

  @@map("kixikilas")
}

model KixikilaMembro {
  id          String   @id @default(cuid())
  kixikilaId  String
  kixikila    Kixikila @relation(fields: [kixikilaId], references: [id])
  usuarioId   String?
  usuario     User?    @relation("KixikilaMembros", fields: [usuarioId], references: [id])
  nome        String
  posicao     Int
  jaRecebeu   Boolean  @default(false)
  contribuicoes KixikilaContribuicao[]
  criadoEm    DateTime @default(now())

  @@unique([kixikilaId, posicao])
  @@map("kixikila_membros")
}

model KixikilaContribuicao {
  id          String   @id @default(cuid())
  kixikilaId  String
  kixikila    Kixikila @relation(fields: [kixikilaId], references: [id])
  membroId    String
  membro      KixikilaMembro @relation(fields: [membroId], references: [id])
  valor       Decimal  @db.Decimal(15, 2)
  periodo     DateTime
  pago        Boolean  @default(false)
  criadoEm    DateTime @default(now())

  @@map("kixikila_contribuicoes")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // F-020: guarda sha256(salt:otp) em hex — nunca o OTP em texto claro
  otp        String    @db.VarChar(64)
  salt       String    @default("") @db.VarChar(32)
  // F-020: contador de tentativas por conta (bloqueio aos 5 erros)
  tentativas Int       @default(0)
  expiresAt  DateTime
  used       Boolean   @default(false)
  criadoEm   DateTime  @default(now())
  usadoEm    DateTime?

  @@index([userId])
}

// Enums para padronização
enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  PREFIRO_NAO_DIZER
}

enum Role {
  USER
  ADMIN
  MODERADOR
}

enum PerfilRisco {
  CONSERVADOR
  MOD_ERADO
  ARROJADO
}

enum TipoCartao {
  DEBITO
  CREDITO
  POUPANCA
}

enum TipoGasto {
  DESPESA
  RECEITA
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoCategoria {
  ESSENCIAL    
  FLEXIVEL     
  POUPANCA     
  RENDIMENTO  
}
