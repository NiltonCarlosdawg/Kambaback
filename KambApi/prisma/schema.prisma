generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model User {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  telefone          String?   @unique
  senha             String
  dataNascimento    DateTime
  sexo              String
  morada            String
  rendaMensalMedia  Float     @default(0)
  perfilDeRisco     String    @default("moderado")
  
  role              String    @default("user")
  ativo             Boolean   @default(true)
  bloqueado         Boolean   @default(false)
  verificado        Boolean   @default(false)
  
  refreshToken      String?
  senhaAlteradaEm   DateTime?
  ultimoLogin       DateTime?
  
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  // Relações
  cartoes           Cartao[]
  gastos            Gasto[]
  objetivos         Objetivo[]
  categorias        Categoria[]
  kambaMemoria      KambaMemoria[]
  kambaUsage        KambaUsage[]
  kambaLembretes    KambaLembrete[]
  kambaFeedback     KambaFeedback[]
  dispositivos      DispositivoPush[]
  notificacoes      NotificacaoPush[]
  preferencias      PreferenciasUsuario?

  // Índices úteis
  @@index([email])
  @@index([telefone])
  @@index([refreshToken])
  @@index([ultimoLogin(sort: Desc)])
}

model Cartao {
  id              String    @id @default(uuid())
  usuarioId       String
  nome            String
  tipo            String
  banco           String?
  numero          String?
  saldoAtual      Float     @default(0)
  limiteCredito   Float?    @default(0)
  disponivel      Float?
  cor             String?
  icone           String?
  ativo           Boolean   @default(true)
  bloqueado       Boolean   @default(false)
  criadoEm        DateTime  @default(now())
  excluido      Boolean   @default(false)
  usuario         User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  gastos          Gasto[]

  @@index([usuarioId, ativo])
  @@index([usuarioId, criadoEm(sort: Desc)])
}

model Gasto {
  id            String    @id @default(uuid())
  usuarioId     String
  cartaoId      String
  categoriaId   String
  tipo          String
  valor         Float
  descricao     String?
  data          DateTime
  local         String?
  parcelado     Json?
  tags          String[]
  excluido      Boolean   @default(false)
  criadoEm      DateTime  @default(now())

  usuario       User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cartao        Cartao    @relation(fields: [cartaoId], references: [id])
  categoria     Categoria @relation(fields: [categoriaId], references: [id])

  @@index([usuarioId, data(sort: Desc)])
  @@index([usuarioId, tipo])
  @@index([usuarioId, categoriaId])
  @@index([usuarioId, cartaoId])
  @@index([usuarioId, excluido])
  @@index([data])
}

model Objetivo {
  id                      String    @id @default(uuid())
  usuarioId               String
  titulo                  String
  descricao               String?
  categoria               String
  valorAlvo               Float
  valorAtual              Float     @default(0)
  dataPrevista            DateTime
  prioridade              String    @default("media")
  cor                     String?
  icone                   String?
  concluido               Boolean   @default(false)
  porcentagemDistribuicao Float?    @default(0)
  modoDistribuicao        String    @default("automatico")
  criadoEm                DateTime  @default(now())
  excluido      Boolean   @default(false)
  usuario                 User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, concluido])
  @@index([usuarioId, dataPrevista])
  @@index([usuarioId, concluido, dataPrevista])
}

model Categoria {
  id          String    @id @default(uuid())
  nome        String
  tipo        String
  cor         String?
  icone       String?
  ordem       Int       @default(0)
  padrao      Boolean   @default(false)
  usuarioId   String?
  ativa       Boolean   @default(true)
   excluido      Boolean   @default(false)
  usuario     User?     @relation(fields: [usuarioId], references: [id])
  gastos      Gasto[]

  @@index([usuarioId, padrao])
  @@index([usuarioId, tipo, ordem])
}

model KambaMemoria {
  id           String    @id @default(uuid())
  usuarioId    String
  contexto     Json?
  mensagem     String    @db.Text
  resposta     String    @db.Text
  criadoEm     DateTime  @default(now())
  excluido      Boolean   @default(false)
  usuario      User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm(sort: Desc)])
}

model KambaUsage {
  id        String    @id @default(uuid())
  usuarioId String
  model     String    @default("gpt-oss-120b")
  sucesso   Boolean   @default(true)
  latencia  Int?
  erro      String?   @db.Text
  timestamp DateTime  @default(now())
  
  usuario   User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, timestamp(sort: Desc)])
  @@map("kamba_usage")
}

model KambaLembrete {
  id           String    @id @default(uuid())
  usuarioId    String
  tipo         String
  mensagem     String    @db.Text
  enviado      Boolean   @default(false)
  agendadoPara DateTime
  criadoEm     DateTime  @default(now())
  excluido      Boolean   @default(false)
  usuario      User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, enviado, agendadoPara])
  @@map("kamba_lembretes")
}

model KambaFeedback {
  id         String    @id @default(uuid())
  usuarioId  String
  mensagemId String?
  avaliacao  String
  comentario String?   @db.Text
  criadoEm   DateTime  @default(now())
  excluido      Boolean   @default(false)
  usuario    User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, avaliacao])
  @@index([mensagemId])
  @@map("kamba_feedback")
}

// Modelos que estavam truncados no teu documento original
// (adicionados de forma genérica com base no contexto da aplicação)

model DispositivoPush {
  id           String    @id @default(uuid())
  usuarioId    String
  token        String    @unique
  tipo         String    // "android" | "ios" | "web"
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())

  usuario      User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, ativo])
}

model NotificacaoPush {
  id           String    @id @default(uuid())
  usuarioId    String
  titulo       String
  corpo        String    @db.Text
  lida         Boolean   @default(false)
  tipo         String    // "lembrete", "alerta_gasto", "meta_alcancada", etc
  criadoEm     DateTime  @default(now())

  usuario      User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida, criadoEm(sort: Desc)])
}

model PreferenciasUsuario {
  id                  String    @id @default(uuid())
  usuarioId           String    @unique
  idioma              String    @default("pt")
  tema                String    @default("light")
  notificacoesAtivas  Boolean   @default(true)
  moedaPadrao         String    @default("AOA")
  atualizadoEm        DateTime  @updatedAt

  usuario             User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}