generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A URL é gerida via prisma.config.js no Prisma 7
}

model User {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  telefone          String?   @unique
  senha             String
  dataNascimento    DateTime
  sexo              String
  morada            String
  rendaMensalMedia  Float     @default(0)
  perfilDeRisco     String    @default("moderado")
  
  role              String    @default("user")
  ativo             Boolean   @default(true)
  bloqueado         Boolean   @default(false)
  verificado        Boolean   @default(false)
  
  refreshToken      String?
  senhaAlteradaEm   DateTime?
  ultimoLogin       DateTime?
  
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  // Relações
  cartoes           Cartao[]
  gastos            Gasto[]
  objetivos         Objetivo[]
  categorias        Categoria[]

  @@map("usuarios")
  @@index([email])
  @@index([ativo, bloqueado])
}

model Cartao {
  id              String    @id @default(cuid())
  usuarioId       String
  nome            String
  tipo            String
  banco           String?
  numero          String?
  
  saldoAtual      Float     @default(0)
  limiteCredito   Float     @default(0)
  disponivel      Float     @default(0)
  reservado       Float     @default(0)
  
  cor             String    @default("#1e40af")
  icone           String    @default("credit_card")
  
  ativo           Boolean   @default(true)
  bloqueado       Boolean   @default(false)
  
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  usuario         User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  gastos          Gasto[]

  @@unique([usuarioId, numero])
  @@map("Cartao")
  @@index([usuarioId, ativo])
  @@index([usuarioId, tipo])
}

model Categoria {
  id              String    @id @default(cuid())
  nome            String
  tipo            String    @default("despesa")
  cor             String    @default("#6B7280")
  icone           String    @default("category")
  
  padrao          Boolean   @default(false)
  ativa           Boolean   @default(true)
  ordem           Int       @default(999)
  
  usuarioId       String?
  
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  // Relações
  usuario         User?     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  gastos          Gasto[]

  @@unique([usuarioId, nome])
  @@map("Categoria")
  // ÍNDICES PARA LISTAGEM RÁPIDA
  @@index([padrao, ativa])
  @@index([usuarioId, tipo])
}

model Gasto {
  id              String    @id @default(cuid())
  usuarioId       String
  cartaoId        String
  categoriaId     String?
  
  tipo            String
  valor           Float
  descricao       String    @default("")
  local           String?
  data            DateTime  @default(now())
  
  parcelado       Json?
  tags            String[]  @default([])
  
  excluido        Boolean   @default(false)
  
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  // Relações
  usuario         User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cartao          Cartao    @relation(fields: [cartaoId], references: [id], onDelete: Restrict)
  categoria       Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  @@map("Gasto")
  // ÍNDICES SUPER IMPORTANTES - QUERIES MAIS COMUNS
  @@index([usuarioId, data(sort: Desc)])           // Listagem de gastos por data
  @@index([usuarioId, tipo, data])                 // Filtro por tipo + data
  @@index([usuarioId, categoriaId, data])          // Gastos por categoria
  @@index([usuarioId, excluido, data])             // Gastos não excluídos
  @@index([usuarioId, tipo, excluido, data])       // Query mais comum do dashboard
  @@index([cartaoId])                              // Gastos por cartão
  @@index([tags])                                  // Busca por tags
}

model Objetivo {
  id                        String    @id @default(cuid())
  usuarioId                 String
  
  titulo                    String
  descricao                 String    @default("")
  categoria                 String?
  
  valorAlvo                 Float
  valorAtual                Float     @default(0)
  
  dataInicio                DateTime  @default(now())
  dataFinal                 DateTime
  
  prioridade                String    @default("media")
  cor                       String    @default("#10b981")
  icone                     String    @default("target")
  
  porcentagemDistribuicao   Int       @default(0)
  modoDistribuicao          String    @default("manual")
  
  concluido                 Boolean   @default(false)
  
  criadoEm                  DateTime  @default(now())
  atualizadoEm              DateTime  @updatedAt

  // Relações
  usuario                   User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("Objetivo")
  // ÍNDICES PARA QUERIES DE OBJETIVOS
  @@index([usuarioId, concluido, dataFinal])
  @@index([usuarioId, modoDistribuicao, concluido])
  @@index([usuarioId, prioridade])
}