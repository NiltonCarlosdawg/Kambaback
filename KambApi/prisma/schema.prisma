generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A URL é gerida via .env (DATABASE_URL)
}

model User {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  telefone          String?   @unique
  senha             String
  dataNascimento    DateTime
  sexo              String
  morada            String
  rendaMensalMedia  Float     @default(0)
  perfilDeRisco     String    @default("moderado")
  
  role              String    @default("user")
  ativo             Boolean   @default(true)
  bloqueado         Boolean   @default(false)
  verificado        Boolean   @default(false)
  
  refreshToken      String?
  senhaAlteradaEm   DateTime?
  ultimoLogin       DateTime?
  
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  // Relações existentes
  cartoes           Cartao[]
  gastos            Gasto[]
  objetivos         Objetivo[]
  categorias        Categoria[]

  // Novas relações – Kamba IA
  kambaMemoria      KambaMemoria[]
  kambaUsage        KambaUsage[]
  kambaLembretes    KambaLembrete[]
  kambaFeedback     KambaFeedback[]
  dispositivos      DispositivoPush[]
  notificacoes      NotificacaoPush[]
  preferenciasPush  PreferenciasNotificacao?

  @@map("usuarios")
  @@index([email])
  @@index([ativo, bloqueado])
}

model Cartao {
  id              String    @id @default(cuid())
  usuarioId       String
  nome            String
  tipo            String
  banco           String?
  numero          String?
  
  saldoAtual      Float     @default(0)
  limiteCredito   Float     @default(0)
  disponivel      Float     @default(0)
  reservado       Float     @default(0)
  
  cor             String    @default("#1e40af")
  icone           String    @default("credit_card")
  ativo           Boolean   @default(true)
  bloqueado       Boolean   @default(false)
  
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  usuario         User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  gastos          Gasto[]

  @@map("Cartao")
  @@index([usuarioId, ativo])
}

model Gasto {
  id          String    @id @default(cuid())
  usuarioId   String
  cartaoId    String
  tipo        String    // 'despesa' | 'receita'
  valor       Float
  descricao   String?
  categoriaId String?
  data        DateTime
  local       String?
  excluido    Boolean   @default(false)
  
  parcelado   Json?     // { totalParcelas, parcelaAtual, recorrencia }
  tags        String[]  @default([])
  
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime @updatedAt

  usuario     User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cartao      Cartao    @relation(fields: [cartaoId], references: [id], onDelete: Restrict)
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  @@map("Gasto")
  @@index([usuarioId, excluido, data(sort: Desc)])
  @@index([usuarioId, tipo, excluido, data])
  @@index([cartaoId])
  @@index([tags])
}

model Objetivo {
  id                        String    @id @default(cuid())
  usuarioId                 String
  
  titulo                    String
  descricao                 String    @default("")
  categoria                 String?
  
  valorAlvo                 Float
  valorAtual                Float     @default(0)
  
  dataInicio                DateTime  @default(now())
  dataFinal                 DateTime
  
  prioridade                String    @default("media")
  cor                       String    @default("#10b981")
  icone                     String    @default("target")
  
  porcentagemDistribuicao   Int       @default(0)
  modoDistribuicao          String    @default("manual")
  
  concluido                 Boolean   @default(false)
  
  criadoEm                  DateTime  @default(now())
  atualizadoEm              DateTime  @updatedAt

  usuario                   User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("Objetivo")
  @@index([usuarioId, concluido, dataFinal])
  @@index([usuarioId, modoDistribuicao, concluido])
  @@index([usuarioId, prioridade])
}

model Categoria {
  id          String    @id @default(cuid())
  usuarioId   String?
  nome        String
  tipo        String    // 'despesa' | 'receita'
  cor         String?
  icone       String?
  ordem       Int       @default(0)
  padrao      Boolean   @default(false)
  ativa       Boolean   @default(true)
  
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime @updatedAt

  usuario     User?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  gastos      Gasto[]

  @@map("Categoria")
  @@unique([usuarioId, nome, tipo], name: "categoria_usuario_nome_tipo")
  @@index([padrao, ordem, nome])
}

// ─────────────────────────────────────────────
//          MODELOS NOVOS – KAMBA IA
// ─────────────────────────────────────────────

model KambaMemoria {
  id        String    @id @default(uuid())
  usuarioId String
  role      String    // 'user' | 'assistant' | 'system' (opcional)
  content   String    @db.Text
  timestamp DateTime  @default(now())

  usuario   User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, timestamp(sort: Desc)])
  @@map("kamba_memoria")
}

model KambaUsage {
  id        String    @id @default(uuid())
  usuarioId String
  tokens    Int
  modelo    String    @default("gpt-oss-120b")
  sucesso   Boolean   @default(true)
  latencia  Int?      // ms
  erro      String?   @db.Text
  timestamp DateTime  @default(now())

  usuario   User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, timestamp(sort: Desc)])
  @@map("kamba_usage")
}

model KambaLembrete {
  id           String    @id @default(uuid())
  usuarioId    String
  tipo         String    // 'gasto_alto', 'objetivo_perto', 'fundo_baixo', 'poupanca_diaria', etc
  mensagem     String    @db.Text
  enviado      Boolean   @default(false)
  agendadoPara DateTime
  criadoEm     DateTime  @default(now())

  usuario      User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, enviado, agendadoPara])
  @@map("kamba_lembretes")
}

model KambaFeedback {
  id         String    @id @default(uuid())
  usuarioId  String
  mensagemId String?   // pode referenciar id de KambaMemoria
  avaliacao  String    // 'positivo' | 'negativo' | 'neutro'
  comentario String?   @db.Text
  criadoEm   DateTime  @default(now())

  usuario    User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, avaliacao])
  @@index([mensagemId])
  @@map("kamba_feedback")
}