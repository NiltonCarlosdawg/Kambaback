{
  "name": "kwanza-api",
  "version": "1.0.0",
  "description": "API REST para gestão financeira angolana - Sistema Kwanza 🇦🇴",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --watchAll=false",
    "test:watch": "jest --watch",
    "seed": "node src/utils/seed.js",
    "seed:clean": "node src/utils/seed.js --clean",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "keywords": [
    "finance",
    "angola",
    "kwanza",
    "api",
    "rest",
    "gestao-financeira",
    "postgresSql",
    "express"
  ],
  "author": "Equipa Kwanza",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^6.19.2",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-slow-down": "^3.0.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.9.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "4.1",
    "morgan": "^1.10.1",
    "node-cache": "^5.1.2",
    "node-cron": "^2.0.3",
    "pg": "^8.16.3",
    "prisma": "^6.19.2",
    "rate-limit-redis": "^4.3.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seu-usuario/kwanza-api.git"
  },
  "bugs": {
    "url": "https://github.com/seu-usuario/kwanza-api/issues"
  },
  "homepage": "https://github.com/seu-usuario/kwanza-api#readme",
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
