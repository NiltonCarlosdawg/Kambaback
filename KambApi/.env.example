# ==========================================
# CONFIGURAÇÃO DA API KAMBA 🇦🇴
# ==========================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no Git!

# ==========================================
# BANCO DE DADOS (PostgreSQL). Nota: a recuperação de embeddings usa
# similaridade de cosseno em JS (ver F-034); pgvector foi removido das deps
# porque a extensão não está configurada neste deployment.
# ==========================================
DATABASE_URL="postgresql://usuario:senha@localhost:5432/kambapro?schema=public"

# ==========================================
# AI - KAMBA (Agente Conversacional)
# ==========================================
# Provider compatível com OpenAI (Groq, OpenAI, etc.)
KAMBA_AI_API_KEY=sua_chave_api_aqui
KAMBA_AI_BASE_URL=https://api.groq.com/openai/v1
KAMBA_AI_MODEL=openai/gpt-oss-120b

# Web Search (Tavily) - https://tavily.com
# Opcional: sem esta chave, o Kamba não pesquisa na web
KAMBA_SEARCH_API_KEY=sua_chave_tavily_aqui

# ==========================================
# JWT (JSON Web Token)
# ==========================================
JWT_SECRET=sua_chave_secreta_minimo_32_caracteres
JWT_EXPIRES_IN=15m
REFRESH_SECRET=sua_chave_refresh_diferente
REFRESH_EXPIRES_IN=7d

# ==========================================
# REDIS (Cache, Rate Limiting, Wizard State)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sua_senha_redis

# ==========================================
# WEBSOCKET
# ==========================================
WS_PING_TIMEOUT=60000

# ==========================================
# CLIENTE (Frontend)
# ==========================================
CLIENT_URL=http://localhost:3000

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=teu_client_id.apps.googleusercontent.com

# ==========================================
# ENCRYPTION (AES-256)
# ==========================================
ENCRYPTION_KEY=chave_32_bytes_em_hex_aqui

# ==========================================
# NOTÍCIAS (GNews)
# ==========================================
GNEWS_API_KEY=sua_chave_gnews_aqui

# ==========================================
# FEATURES FLAGS
# ==========================================
ENABLE_KAMBA_AI=true
ENABLE_VOICE_ASSISTANT=true
ENABLE_NEWS_INTEGRATION=true