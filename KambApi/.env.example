# ==========================================
# CONFIGURAÇÃO DA API KWANZA 🇦🇴
# ==========================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no Git!

# ==========================================
# AMBIENTE
# ==========================================
NODE_ENV=development
# Opções: development | production | test

# ==========================================
# SERVIDOR
# ==========================================
PORT=5000
HOST=localhost
API_VERSION=v1

# ==========================================
# CLIENTE (Frontend)
# ==========================================
CLIENT_URL=http://localhost:3000
# Em produção: https://seu-dominio.com

# ==========================================
# MONGODB
# ==========================================
# Local:
MONGODB_URI=mongodb://localhost:27017/kwanza

# MongoDB Atlas (Produção):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kwanza?retryWrites=true&w=majority

# Opções de conexão
MONGODB_TIMEOUT=5000
MONGODB_POOL_SIZE=10

# ==========================================
# JWT (JSON Web Token)
# ==========================================
JWT_SECRET=sua_chave_secreta_super_segura_minimo_32_caracteres_aqui
JWT_EXPIRE=7d
# Opções: 1h, 24h, 7d, 30d

JWT_REFRESH_SECRET=sua_chave_refresh_token_diferente_da_principal
JWT_REFRESH_EXPIRE=30d

# ==========================================
# BCRYPT
# ==========================================
BCRYPT_SALT_ROUNDS=10
# Quanto maior, mais seguro mas mais lento (8-12 recomendado)

# ==========================================
# APIs EXTERNAS - NOTÍCIAS
# ==========================================
# NewsAPI (https://newsapi.org/)
NEWSAPI_KEY=4e76537e79ac4788aae1b711c8d178b9

# GNews (https://gnews.io/)
GNEWS_KEY=d23ec0c20297875bc920de95f4b97dc1

# NewsData (https://newsdata.io/)
NEWSDATA_KEY=pub_990ccea3b6b44e098f19c6383769fe2c

# APItube (se usar)
APITUBE_KEY=

# ==========================================
# CACHE
# ==========================================
# Cache de notícias (em segundos)
NEWS_CACHE_TTL=3600
# 3600s = 1 hora

# Cache geral
CACHE_ENABLED=true
CACHE_MAX_SIZE=100

# ==========================================
# RATE LIMITING
# ==========================================
# Janela de tempo (milissegundos)
RATE_LIMIT_WINDOW_MS=900000
# 900000ms = 15 minutos

# Máximo de requisições por IP na janela
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit para rotas sensíveis (login, register)
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=900000

# ==========================================
# LOGS
# ==========================================
LOG_LEVEL=debug
# Opções: error | warn | info | debug

LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:3000
# Em produção, liste domínios separados por vírgula:
# CORS_ORIGIN=https://app.kwanza.ao,https://admin.kwanza.ao

# ==========================================
# EMAIL (Futuro - Notificações)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-app
# EMAIL_FROM=noreply@kwanza.ao

# ==========================================
# UPLOADS (Futuro - Fotos de perfil)
# ==========================================
# MAX_FILE_SIZE=5242880
# 5MB em bytes
# UPLOAD_PATH=./uploads

# ==========================================
# ANÁLISE E MONITORAMENTO
# ==========================================
# Sentry (Error tracking)
# SENTRY_DSN=

# Google Analytics
# GA_TRACKING_ID=

# ==========================================
# FEATURES FLAGS
# ==========================================
ENABLE_KAMBA_AI=true
ENABLE_NEWS_INTEGRATION=true
ENABLE_VOICE_ASSISTANT=true

# ==========================================
# SEGURANÇA
# ==========================================
# Máximo de tentativas de login
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=900000
# 15 minutos

# Session timeout
SESSION_TIMEOUT=86400000
# 24 horas

# ==========================================
# DESENVOLVIMENTO
# ==========================================
# Mostrar queries MongoDB no console
MONGOOSE_DEBUG=false

# Auto-popular banco com dados de teste
AUTO_SEED=false

# Desabilitar autenticação (APENAS DEV!)
DISABLE_AUTH=false